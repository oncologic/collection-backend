# Twilio Configuration for SMS Features
# Required for SMS notification and text-to-notation functionality

# Your Twilio Account SID
# Found at: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here

# Your Twilio Auth Token
# Found at: https://console.twilio.com/
# Keep this secret!
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Your Twilio Phone Number
# Format: +1234567890 (include country code)
# This is the number that will send SMS messages
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Base URL for webhooks
# This should be your server's public URL
# Example: https://your-domain.com
BASE_URL=https://your-backend-url.com

# Frontend URL for links in SMS messages
# Example: https://your-frontend.com
FRONTEND_URL=https://your-frontend-url.com